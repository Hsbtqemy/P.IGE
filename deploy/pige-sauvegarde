#!/bin/sh
# Nightly backup of P.IGE (installed as /usr/local/bin/pige-sauvegarde, run by
# pige-sauvegarde.timer as the pige user). Keeps 14 days.
set -eu
DEST=/var/lib/pige/sauvegardes
DAY=$(date +%F)
mkdir -p "$DEST"
chmod 700 "$DEST"
# SQLite's own backup: a consistent copy even while the service writes.
/opt/pige/venv/bin/python - "$DEST/pige-$DAY.sqlite3" <<'PY'
import sqlite3, sys
src = sqlite3.connect("/var/lib/pige/data/pige.sqlite3")
dst = sqlite3.connect(sys.argv[1])
src.backup(dst)
dst.close(); src.close()
PY
# Legacy JSON data (current web app, Thunderbird extension).
tar czf "$DEST/json-$DAY.tgz" -C /var/lib/pige/data --exclude='pige.sqlite3*' --exclude='.pige.lock' .
find "$DEST" -type f -mtime +14 -delete
