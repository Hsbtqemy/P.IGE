# Copy to /etc/pige/pige.env (owner root, group pige, mode 0640) and fill in.
# Generate the values on the server with the commands shown.

# Data directory (test data during the proof of concept).
PIGE_DATA_DIR=/var/lib/pige/data

# Compiled web interface.
PIGE_WEB_DIR=/opt/pige/app/web/build

# python -m pige.server hash-password
PIGE_PASSWORD_HASH=

# python -m pige.server new-secret
PIGE_SESSION_SECRET=

# python -m pige.server new-token   (hashes only, comma-separated; one per device or extension)
PIGE_API_TOKEN_HASHES=

# Session length in days before asking for the password again.
PIGE_SESSION_DAYS=30

# Log out every device: set to the current Unix time (date +%s) and restart.
# Changing the password also ends every session.
PIGE_SESSIONS_NOT_BEFORE=0
