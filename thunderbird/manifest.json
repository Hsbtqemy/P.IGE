{
  "manifest_version": 3,
  "name": "P.IGE",
  "version": "0.3.6",
  "description": "Ouvre P.IGE dans la barre des espaces, transforme un mail en tâche ou le note dans le journal, et garde le suivi des réponses.",
  "author": "Hsbtqemy",
  "browser_specific_settings": {
    "gecko": {
      "id": "pige@hsbtqemy.github",
      "strict_min_version": "153.0",
      "update_url": "https://github.com/Hsbtqemy/P.IGE/releases/download/thunderbird-updates/updates.json"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "accountsRead",
    "compose",
    "menus",
    "messagesRead",
    "notifications",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "options_ui": {
    "page": "options.html"
  },
  "message_display_action": {
    "default_title": "P.IGE",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
